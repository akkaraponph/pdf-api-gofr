{
	"info": {
		"name": "PDF API (GoFr)",
		"description": "REST API for PDF operations: conversion, generation, and manipulation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000"
		}
	],
	"item": [
		{
			"name": "Converter",
			"item": [
				{
					"name": "PDF to Images",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/to-images",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "PDF file to convert"
								},
								{
									"key": "format",
									"value": "jpeg",
									"type": "text",
									"description": "Output format: jpeg or png (default: jpeg)"
								},
								{
									"key": "dpi",
									"value": "300",
									"type": "text",
									"description": "Resolution (default: 300)"
								},
								{
									"key": "pages",
									"value": "1",
									"type": "text",
									"description": "Comma-separated 1-indexed page numbers, e.g. 1,3,5 (empty = all)"
								}
							]
						},
						"description": "Convert a PDF file into images. Single page returns an image (previewable). Multiple pages return a zip."
					},
					"response": [
						{
							"name": "Single page (image preview)",
							"originalRequest": {
								"method": "POST",
								"url": "{{baseUrl}}/api/pdf/to-images",
								"body": {
									"mode": "formdata",
									"formdata": [
										{ "key": "pdf", "type": "file", "src": "" },
										{ "key": "format", "value": "jpeg", "type": "text" },
										{ "key": "pages", "value": "1", "type": "text" }
									]
								}
							},
							"status": "OK",
							"code": 200,
							"header": [
								{ "key": "Content-Type", "value": "image/jpeg" }
							],
							"body": "",
							"_postman_previewlanguage": "raw"
						},
						{
							"name": "Multiple pages (zip)",
							"originalRequest": {
								"method": "POST",
								"url": "{{baseUrl}}/api/pdf/to-images",
								"body": {
									"mode": "formdata",
									"formdata": [
										{ "key": "pdf", "type": "file", "src": "" },
										{ "key": "format", "value": "jpeg", "type": "text" }
									]
								}
							},
							"status": "OK",
							"code": 200,
							"header": [
								{ "key": "Content-Type", "value": "application/zip" }
							],
							"body": "",
							"_postman_previewlanguage": "raw"
						}
					]
				},
				{
					"name": "Images to PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/images/to-pdf",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "image1",
									"type": "file",
									"src": "",
									"description": "First image (required)"
								},
								{
									"key": "image2",
									"type": "file",
									"src": "",
									"description": "Second image (optional)",
									"disabled": true
								},
								{
									"key": "image3",
									"type": "file",
									"src": "",
									"description": "Third image (optional)",
									"disabled": true
								},
								{
									"key": "page_size",
									"value": "a4",
									"type": "text",
									"description": "Page size: a3, a4, a5, letter, legal"
								},
								{
									"key": "fit",
									"value": "fit",
									"type": "text",
									"description": "Fit mode: fit, fill, stretch"
								}
							]
						},
						"description": "Combine uploaded images into a single PDF."
					}
				}
			]
		},
		{
			"name": "Generator",
			"item": [
				{
					"name": "HTML to PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/html/to-pdf",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"html\": \"<h1>Hello World</h1><p>This is a test PDF.</p>\",\n  \"page_size\": \"a4\",\n  \"landscape\": false,\n  \"margin_left\": 10,\n  \"margin_top\": 10,\n  \"margin_right\": 10,\n  \"margin_bottom\": 10,\n  \"title\": \"Sample Document\",\n  \"author\": \"\",\n  \"subject\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Render HTML content as a PDF."
					}
				},
				{
					"name": "Markdown to PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/markdown/to-pdf",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"markdown\": \"# Hello World\\n\\nThis is a **test** PDF from Markdown.\",\n  \"page_size\": \"a4\",\n  \"landscape\": false,\n  \"bookmarks\": true,\n  \"margin_left\": 10,\n  \"margin_top\": 10,\n  \"margin_right\": 10,\n  \"margin_bottom\": 10,\n  \"title\": \"Sample Markdown Document\",\n  \"author\": \"\",\n  \"subject\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Render Markdown content as a PDF."
					}
				}
			]
		},
		{
			"name": "Operations",
			"item": [
				{
					"name": "Merge PDFs",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/merge",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file1",
									"type": "file",
									"src": "",
									"description": "First PDF (required)"
								},
								{
									"key": "file2",
									"type": "file",
									"src": "",
									"description": "Second PDF (required)"
								},
								{
									"key": "file3",
									"type": "file",
									"src": "",
									"description": "Third PDF (optional)",
									"disabled": true
								}
							]
						},
						"description": "Merge multiple PDF files into one. At least 2 files required."
					}
				},
				{
					"name": "Split PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/split",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "PDF file to split"
								},
								{
									"key": "ranges",
									"value": "1-3,4-6",
									"type": "text",
									"description": "Page ranges, e.g. 1-3,5-7"
								}
							]
						},
						"description": "Split a PDF into parts by page ranges. Returns a single PDF or a zip."
					}
				},
				{
					"name": "Compress PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/compress",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "PDF file to compress"
								},
								{
									"key": "image_quality",
									"value": "75",
									"type": "text",
									"description": "Image quality 1-100 (optional)"
								}
							]
						},
						"description": "Compress a PDF file."
					}
				},
				{
					"name": "Watermark PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/watermark",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "PDF file to watermark"
								},
								{
									"key": "text",
									"value": "DRAFT",
									"type": "text",
									"description": "Watermark text (required if no template)"
								},
								{
									"key": "template",
									"value": "",
									"type": "text",
									"description": "Template: draft, confidential, copy, sample, do-not-copy",
									"disabled": true
								},
								{
									"key": "font_size",
									"value": "48",
									"type": "text",
									"description": "Font size (optional)"
								},
								{
									"key": "opacity",
									"value": "0.3",
									"type": "text",
									"description": "Opacity 0-1 (optional)"
								},
								{
									"key": "rotation",
									"value": "45",
									"type": "text",
									"description": "Rotation angle (optional)"
								},
								{
									"key": "color_r",
									"value": "200",
									"type": "text",
									"description": "Red component 0-255 (optional)",
									"disabled": true
								},
								{
									"key": "color_g",
									"value": "200",
									"type": "text",
									"description": "Green component 0-255 (optional)",
									"disabled": true
								},
								{
									"key": "color_b",
									"value": "200",
									"type": "text",
									"description": "Blue component 0-255 (optional)",
									"disabled": true
								}
							]
						},
						"description": "Add a watermark to a PDF."
					}
				},
				{
					"name": "Extract Text",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/extract-text",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "PDF file to extract text from"
								}
							]
						},
						"description": "Extract text content from a PDF. Returns JSON."
					}
				},
				{
					"name": "Decrypt PDF",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/pdf/decrypt",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "pdf",
									"type": "file",
									"src": "",
									"description": "Encrypted PDF file"
								},
								{
									"key": "password",
									"value": "",
									"type": "text",
									"description": "PDF password (required)"
								}
							]
						},
						"description": "Remove password protection from a PDF."
					}
				}
			]
		}
	]
}
